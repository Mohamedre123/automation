# ===== Vercel + Supabase (set these in Vercel -> Project -> Settings -> Environment Variables) =====
# Supabase -> Connect -> "Transaction pooler" (port 6543) connection string
DATABASE_URL=
# Long random string (>= 32 chars). Encrypts customer API keys - never change it after going live.
APP_SECRET=
# Your site URL, e.g. https://tadfuq.vercel.app (used for webhook links and Telegram)
PUBLIC_URL=
# Random string; the scheduler calls /api/cron/tick with it
CRON_SECRET=
# false = only the first account (you) can register
ALLOW_SIGNUP=false

# ===== Local development (all optional) =====
# PORT=3000
# HOST=127.0.0.1
# DATA_DIR=            # embedded Postgres location when DATABASE_URL is empty
# MAX_CONCURRENT_EXECUTIONS=5

# Optional: store generated videos in Supabase Storage (needed on Vercel for videos over ~4MB)
# Supabase -> Project Settings -> API: Project URL + service_role key
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media

# "Connect with ..." buttons (OAuth). Register one app per provider with this redirect URL:
#   {PUBLIC_URL}/api/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Protection (0 = unlimited)
MAX_EXECUTIONS_PER_DAY=5000
MAX_WORKFLOWS_PER_USER=300
WEBHOOK_RATE_PER_MINUTE=120
