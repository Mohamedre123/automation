# Port the API + webhooks listen on
PORT=3000
# 127.0.0.1 locally; 0.0.0.0 on a server
HOST=127.0.0.1
# Public base URL used to build webhook links (your domain in production)
PUBLIC_URL=http://localhost:3000
# Long random string (>= 32 chars). Encrypts stored credentials - never change it after going live.
# Leave empty locally: one is generated into server/data/secret.key
APP_SECRET=
# Where the SQLite database lives
DATA_DIR=
MAX_CONCURRENT_EXECUTIONS=5
